*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# IDE and Editors
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
.project
.pydevproject
.spyderproject
.spyproject

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Project-specific exclusions
PROJECT_MEMORY.md
nul

# CatBoost training cache (can be regenerated)
catboost_info/

# Log files
*.log
logs/

# Environment variables
.env
.env.local
.env.*.local

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# pytest cache
.pytest_cache/
.coverage
htmlcov/

# mypy cache
.mypy_cache/

# Temporary files
*.tmp
*.temp
*.bak

# Large model files that might exceed GitHub limits (optional)
# Uncomment if needed:
# *.pkl
# *.joblib

# Keep these files (do NOT ignore):
